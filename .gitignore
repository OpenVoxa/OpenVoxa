# Local to each server
deploy/docker-compose.override.yml
# Published desktop builds. The folder itself is kept (.gitkeep) so it
# exists owned by whoever cloned the repo; left to Docker, the first
# `compose up` would create it owned by root and releases couldn't write.
deploy/desktop-updates/*
!deploy/desktop-updates/.gitkeep
/client-desktop/update-url.local

