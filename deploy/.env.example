#
# Copy to .env and edit. .env is gitignored; never commit real secrets.
#
#   cp .env.example .env

# ---------------------------------------------------------------- database
# Generate something long:  openssl rand -base64 32
POSTGRES_PASSWORD=devpassword

# ----------------------------------------------------------------- livekit
# Generate a matching pair:
#   docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=CHANGEME
LIVEKIT_API_SECRET=CHANGEME

# The address clients send MEDIA to. Media is UDP and never passes through
# Caddy, so this stays an IP even after TLS is working.
#   LAN only          your server's LAN address, e.g. 10.0.3.9
#   Internet facing   your public IP, with UDP 50000-50100 forwarded
LIVEKIT_NODE_IP=10.0.3.9

# What the BROWSER connects to for signalling.
#   Without TLS   ws://10.0.3.9:7880
#   With TLS      wss://openvoxa.example.net      (Caddy routes /rtc)
OPENVOXA_LIVEKIT_URL=wss://openvoxa.example.net

# --------------------------------------------------------------------- tls
# Only used with:  docker compose --profile tls up -d

# Hostname clients use. Must match the certificate.
OPENVOXA_DOMAIN=openvoxa.example.net

# Which deployment path. See the comments at the top of each file.
#   Caddyfile.http       public domain, ports 80/443 reachable
#   Caddyfile.dns        public domain, no inbound access
#   Caddyfile.internal   LAN only, no domain
CADDYFILE=Caddyfile.http

# Let's Encrypt contact address. Not needed for Caddyfile.internal.
CADDY_EMAIL=you@example.net

# Only for Caddyfile.dns. Cloudflare token needs Zone:DNS:Edit on this zone.
CLOUDFLARE_API_TOKEN=

# Behind Caddy this should be true so rate limiting sees real client
# addresses. Without a proxy it MUST stay false, or anyone can spoof the
# header and bypass the limiter.
OPENVOXA_TRUST_PROXY=true

# ------------------------------------------------------------------- debug
# Serves a throwaway test client at /debug/chat.html. Leave false unless
# you are developing.
OPENVOXA_DEBUG_UI=false
