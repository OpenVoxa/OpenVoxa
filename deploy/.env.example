#
# Copy to .env and edit. .env is gitignored; never commit real secrets.
#
#   cp .env.example .env

# ---------------------------------------------------------------- database
# Required. Generate something long:  openssl rand -hex 24
# Postgres only reads it when the database is first created, so changing
# it later locks the server out of an existing database.
POSTGRES_PASSWORD=

# ----------------------------------------------------------------- livekit
# Generate a matching pair:
#   docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=CHANGEME
LIVEKIT_API_SECRET=CHANGEME

# The address clients send MEDIA to. Media is UDP and never passes through
# Caddy, so this stays an IP even after TLS is working.
#   LAN only          your server's LAN address, e.g. 192.168.1.10
#   Internet facing   your public IP, with UDP 50000-50100 forwarded
# LiveKit also offers the server's LAN address on its own, so with the
# public IP here people on your LAN still connect directly.
LIVEKIT_NODE_IP=192.168.1.10

# What the BROWSER connects to for signalling.
#   Without TLS   ws://192.168.1.10:7880   (LiveKit listens on the host)
#   With TLS      wss://openvoxa.example.net      (Caddy routes /rtc)
OPENVOXA_LIVEKIT_URL=wss://openvoxa.example.net

# --------------------------------------------------------------------- tls
# Only used with:  docker compose --profile tls up -d

# Hostname clients use. Must match the certificate.
OPENVOXA_DOMAIN=openvoxa.example.net

# Which deployment path. See the comments at the top of each file.
#   Caddyfile.http       public domain, ports 80/443 reachable
#   Caddyfile.dns        public domain, no inbound access
#   Caddyfile.internal   LAN only, no domain
CADDYFILE=Caddyfile.http

# Let's Encrypt contact address. Not needed for Caddyfile.internal.
CADDY_EMAIL=you@example.net

# Only for Caddyfile.dns. A Cloudflare token for this zone only, with
# DNS: Edit and Zone: Read (deploy/README.md, "Caddyfile.dns").
CLOUDFLARE_API_TOKEN=

# Behind Caddy this should be true so rate limiting sees real client
# addresses. Without a proxy it MUST stay false, or anyone can spoof the
# header and bypass the limiter.
OPENVOXA_TRUST_PROXY=true

# ------------------------------------------------------- account key encryption
# Optional but recommended. Encrypts every account key where it rests in
# the key-data volume, so a stolen key-folder backup cannot decrypt
# anything on its own. Generate 32 random bytes, base64:
#   openssl rand -base64 32
# Then keep a copy somewhere safe and SEPARATE from both your database
# backups and your key-folder backups. Losing this key makes plaintext
# channel history unreadable; see deploy/README.md, "Account keys and
# backups". Leave empty to store account keys in the clear.
OPENVOXA_KEK=

# ------------------------------------------------------------- optional
# Per-file upload limit in megabytes (default 25).
# OPENVOXA_MAX_ATTACHMENT_MB=25

# GIF search, off by default: giphy or tenor, plus that provider's API
# key (deploy/README.md, "GIF search"). The provider sees what this server
# searches for, never who searched.
# OPENVOXA_GIF_PROVIDER=giphy
# OPENVOXA_GIF_API_KEY=

# Where the server calls LiveKit's admin API (to remove someone from a
# call). The default suits this compose file; change it only if LiveKit
# runs elsewhere.
# OPENVOXA_LIVEKIT_API_URL=http://host.docker.internal:7880
